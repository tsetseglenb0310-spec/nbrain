# Required for semantic search and answers.
OPENAI_API_KEY=your_key_here

# Optional: enables Claude for detailed book and strategy analysis.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional overrides.
NBRAIN_MODEL=gpt-4o-mini
NBRAIN_CLAUDE_MODEL=claude-sonnet-4-6
NBRAIN_EMBEDDING_MODEL=text-embedding-3-small
NBRAIN_PORT=8000
# Where the database and the uploaded books live. In Docker this is the volume.
NBRAIN_DATA_DIR=./data

# Required before exposing NBrain to the internet.
# With NBRAIN_AUTH_REQUIRED=0 every request is treated as the primary account
# and needs no cookie, so the server refuses to start in that mode unless it is
# bound to loopback.
NBRAIN_AUTH_REQUIRED=1
# Login and password of the first account. They are used only to create it on an
# empty database; afterwards accounts live in the users table and passwords are
# changed in the interface. Existing installations keep the password they had.
NBRAIN_ADMIN_USERNAME=admin
NBRAIN_ADMIN_PASSWORD=choose_a_long_unique_password
# Name shown in the interface. The login stays ASCII so it is typeable on any
# keyboard; this one can be in any alphabet and is editable later in the profile.
NBRAIN_ADMIN_DISPLAY_NAME=
# At least 32 characters. Changing it signs everyone out.
NBRAIN_SESSION_SECRET=generate_a_long_random_secret
NBRAIN_SECURE_COOKIES=1
# Public address of the deployment. Used in the links inside e-mails and to
# accept requests from your own domain when a proxy rewrites Host.
NBRAIN_PUBLIC_URL=https://app.example.org

# Outgoing mail: confirmation of an address and password recovery. Without
# NBRAIN_SMTP_HOST nothing is sent — the letter is written to the log and shown
# to the administrator instead, so both flows still work, just manually.
NBRAIN_SMTP_HOST=smtp.example.org
NBRAIN_SMTP_PORT=587
NBRAIN_SMTP_USER=nbrain@example.org
NBRAIN_SMTP_PASSWORD=app_specific_password
NBRAIN_SMTP_FROM=NBrain <nbrain@example.org>
# starttls (default, port 587), ssl (port 465) or none.
NBRAIN_SMTP_SECURITY=starttls

# Set to 0 to leave account creation to administrators only.
NBRAIN_REGISTRATION_OPEN=1

# Behind a reverse proxy: without one of these every client shares a single
# login-throttling key, and one person guessing passwords locks out everyone.
# On Render, Fly and Cloud Run the platform proxy is the only way in, so
# trusting the header is correct there.
NBRAIN_TRUST_FORWARDED_FOR=1
# On your own nginx or HAProxy, list its addresses instead.
# NBRAIN_TRUSTED_PROXIES=10.0.0.2,10.0.0.3

# Per-account quotas. Answers and searches cost money at OpenAI.
NBRAIN_RATE_ANSWER=30
NBRAIN_RATE_SEARCH=120
NBRAIN_RATE_UPLOAD=40

# Indexing pool. Raise only together with the CPU and the API rate limit.
NBRAIN_INDEX_WORKERS=2
NBRAIN_INDEX_QUEUE=64
